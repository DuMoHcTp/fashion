// Клиентские типы и хелперы приложения «Гардероб AI»

export interface ParsedMatch {
  id: string
  name: string
  score: number
  reason: string
}

export interface ParsedOutfit {
  title: string
  items: string[]
  occasion: string
  description: string
}

export interface ParsedMatchAnalysis {
  id: string
  itemId: string
  score: number
  summary: string
  matches: ParsedMatch[]
  outfits: ParsedOutfit[]
  gaps: string[]
  updatedAt: string
}

export interface WardrobeItem {
  id: string
  name: string
  category: string
  subtype: string
  colors: string[]
  style: string
  seasons: string[]
  material: string | null
  description: string
  imageUrl: string
  createdAt: string
  match: ParsedMatchAnalysis | null
}

// Разбор JSON-строк из ответа API
export function parseWardrobeItem(raw: Record<string, unknown>): WardrobeItem {
  const parseArr = (v: unknown): string[] => {
    try {
      const arr = typeof v === 'string' ? JSON.parse(v) : v
      return Array.isArray(arr) ? arr.filter((x) => typeof x === 'string') : []
    } catch {
      return []
    }
  }

  let match: ParsedMatchAnalysis | null = null
  const m = raw.match as Record<string, unknown> | null | undefined
  if (m && typeof m === 'object' && typeof m.score === 'number') {
    const tryParse = (v: unknown, fb: unknown) => {
      try {
        return typeof v === 'string' ? JSON.parse(v) : v ?? fb
      } catch {
        return fb
      }
    }
    match = {
      id: String(m.id ?? ''),
      itemId: String(m.itemId ?? ''),
      score: Number(m.score) || 0,
      summary: String(m.summary ?? ''),
      matches: tryParse(m.matches, []) as ParsedMatch[],
      outfits: tryParse(m.outfits, []) as ParsedOutfit[],
      gaps: tryParse(m.gaps, []) as string[],
      updatedAt: String(m.updatedAt ?? ''),
    }
  }

  return {
    id: String(raw.id),
    name: String(raw.name ?? ''),
    category: String(raw.category ?? ''),
    subtype: String(raw.subtype ?? ''),
    colors: parseArr(raw.colors),
    style: String(raw.style ?? ''),
    seasons: parseArr(raw.seasons),
    material: raw.material ? String(raw.material) : null,
    description: String(raw.description ?? ''),
    imageUrl: String(raw.imageUrl ?? ''),
    createdAt: String(raw.createdAt ?? ''),
    match,
  }
}

