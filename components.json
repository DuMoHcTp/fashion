export function colorHex(colorName: string): string {
  const lower = colorName.toLowerCase()
  for (const [key, hex] of COLOR_HEX_RULES) {
    if (lower.includes(key)) return hex
  }
  return '#b6ae9f' // нейтральный фолбэк
}

// ---------- Форматирование даты ----------

export function formatDate(iso: string): string {
  try {
    return new Date(iso).toLocaleString('ru-RU', {
      day: 'numeric',
      month: 'long',
      hour: '2-digit',
      minute: '2-digit',
    })
  } catch {
    return ''
  }
}

// ---------- Оценка совместимости ----------

export function scoreColor(score: number): { stroke: string; text: string; label: string } {
  if (score >= 70) {
    return { stroke: '#2e9e6b', text: 'text-emerald-700', label: 'Отлично вписывается' }
  }
  if (score >= 45) {
    return { stroke: '#d99a2b', text: 'text-amber-600', label: 'Хорошо, но с нюансами' }
  }
  return { stroke: '#d04f4f', text: 'text-red-600', label: 'Выпадает из гардероба' }
}
